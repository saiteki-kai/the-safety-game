{
	"extends": "astro/tsconfigs/base",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"paths": {
			"@components/*": ["./src/components/*"],
			"@layouts/*": ["./src/layouts/*"],
			"@assets/*": ["./src/assets/*"],
			"@content/*": ["./src/content/*"],
			"@utils/*": ["./src/utils/*"],
			"@styles/*": ["./src/styles/*"],
			"@scripts/*": ["./src/scripts/*"]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
