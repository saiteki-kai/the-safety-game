---
import Icon from "@components/common/Icon.astro";
import { navigationLinks } from "@content/site-config";
---

<a href="#main-content" class="skip-link">Salta al contenuto principale</a>
<nav data-site-nav class="site-nav nav-bar" aria-label="Navigazione principale">
  <div class="section-container">
    <div class="nav-inner">
      <a href="#home" class="nav-brand text-xl tracking-tight font-semibold">
          <img src="/demo-github-pages/images/logos/safety_game_logo.png" alt="The Safety Game" class="h-10 md:h-10 w-auto block" />
      </a>
      <div class="nav-actions">
        <div class="nav-links">
          {
            navigationLinks.map((link) => (
              <a
                href={link.href}
                class={[
                  "nav-link",
                  link.href === "#home" ? "nav-link--active" : "",
                ]
                  .filter(Boolean)
                  .join(" ")}
                data-nav-link
                data-section={link.href.substring(1)}
                aria-current={link.href === "#home" ? "true" : undefined}
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </div>
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="mobile-navigation"
        data-mobile-toggle
      >
        <Icon data-icon="open" name="menu" size={24} />
        <Icon data-icon="close" name="x" size={24} class="hidden" />
        <span class="sr-only" data-sr-text>Apri il menu</span>
      </button>
    </div>
  </div>
</nav>
<div id="mobile-navigation" class="mobile-nav-panel hidden" data-mobile-panel>
  <div class="mobile-nav-card">
    {
      navigationLinks.map((link) => (
        <a
          href={link.href}
          class={[
            "mobile-nav-link",
            link.href === "#home" ? "mobile-nav-link--active" : "",
          ]
            .filter(Boolean)
            .join(" ")}
          data-mobile-link
          data-section={link.href.substring(1)}
          aria-current={link.href === "#home" ? "true" : undefined}
        >
          {link.label}
        </a>
      ))
    }
  </div>
</div>

<script src="@scripts/navigation.ts"></script>
