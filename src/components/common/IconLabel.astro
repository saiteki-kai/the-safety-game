---
import type { HTMLTag } from "astro/types";
import Icon from "./Icon.astro";

const {
	name,
	size = 20,
	iconClass = "",
	class: className = "",
	strokeWidth = 2,
	as = "span",
	position = "start",
} = Astro.props as {
	name: string;
	size?: number;
	iconClass?: string;
	class?: string;
	strokeWidth?: number;
	as?: HTMLTag;
	position?: "start" | "end";
};

const Tag = as as HTMLTag;
---

<Tag class={`inline-flex items-center gap-2 ${className}`.trim()}>
  {
    position === "start" ? (
      <>
        <Icon
          name={name}
          size={size}
          class={`${iconClass} shrink-0`.trim()}
          strokeWidth={strokeWidth}
        />
        <slot />
      </>
    ) : (
      <>
        <slot />
        <Icon
          name={name}
          size={size}
          class={`${iconClass} shrink-0`.trim()}
          strokeWidth={strokeWidth}
        />
      </>
    )
  }
</Tag>
