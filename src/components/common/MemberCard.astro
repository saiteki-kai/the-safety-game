---
import { Image } from "astro:assets";

export interface TeamMember {
  name: string;
  role: string;
  bio: string;
  image?: ImageMetadata;
  email: string;
}

const {
  member,
  size = "md",
  showEmail = true,
  class: className = "",
} = Astro.props as {
  member: TeamMember;
  size?: "sm" | "md" | "lg";
  showEmail?: boolean;
  class?: string;
};
const sizeMap = {
  sm: { wrapper: "avatar-sm", px: 56 },
  md: { wrapper: "avatar-md", px: 72 },
  lg: { wrapper: "avatar-lg", px: 96 },
} as const;

const chosen = sizeMap[size as keyof typeof sizeMap] ?? sizeMap.md;

const initial = member?.name?.trim()?.charAt(0) ?? "?";
const imageData = member?.image ?? null;
const intrinsic = chosen.px;
const headingId = `member-${(member?.name ?? "")
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}-name`;
---

<div
  class={`member-card ${className}`}
  role="group"
  aria-labelledby={headingId}
>
  <div class="member-card-inner">
    <div class="shrink-0">
      <div class={`${chosen.wrapper} avatar-base`}>
        {
          imageData ? (
            <>
              <Image
                class="avatar-img"
                src={imageData}
                alt={`Photo of ${member.name}`}
                onerror={
                  "this.style.display='none'; this.closest('.avatar-base').querySelector('.avatar-fallback').classList.remove('hidden'); this.closest('.avatar-base').querySelector('.avatar-fallback').classList.add('flex');"
                }
                onload={
                  "this.closest('.avatar-base').querySelector('.avatar-fallback').classList.add('hidden');"
                }
                width={intrinsic}
                height={intrinsic}
              />
              <div class="avatar-fallback" aria-hidden="true">
                {initial}
              </div>
            </>
          ) : (
            <div class="avatar-fallback flex" aria-hidden="true">
              {initial}
            </div>
          )
        }
      </div>
    </div>

    <div class="flex-1 min-w-0">
      <h3 id={headingId} class="member-name">
        {member.name}
      </h3>
      {member.role && <p class="member-role">{member.role}</p>}

      {
        showEmail && member.email && (
          <p class="member-email">
            <a
              class="member-link"
              href={`mailto:${member.email}`}
              title={`Email ${member.name}`}
            >
              {member.email}
            </a>
          </p>
        )
      }
    </div>
  </div>
</div>
