---
import GithubIcon from "@assets/github.svg";
import HuggingFaceIcon from "@assets/huggingface.svg";
import { FOOTER_LINKS } from "@lib/consts";
import { Mail } from "lucide-react";
import Copyright from "@/components/common/Copyright.astro";

import { Separator } from "@/components/ui/separator";

import { footerQuickLinks } from "@/content/site-config";
import type { FooterQuickLink } from "@/content/site-config";
import { footer as t } from "@i18n/locales/it";

const quickLinks: FooterQuickLink[] = footerQuickLinks;

---

<footer
  class="relative overflow-hidden bg-neutral-950 text-white py-14 md:py-16"
>
  <div
    class="absolute inset-x-0 top-0 h-2 bg-linear-to-r from-white/20 via-transparent to-white/20 opacity-60"
    aria-hidden="true"
  >
  </div>
  <div
    class="section-container relative z-10 space-y-10 text-sm text-neutral-300"
  >
    <div class="grid gap-8 md:grid-cols-[1.5fr_1fr_1fr]">
      <div class="space-y-4">
        <p class="text-lg font-semibold text-white">The Safety Game</p>
        <p class="max-w-xl text-sm text-neutral-400">
          {t?.tagline ?? "An ethical prompt engineering competition."}
        </p>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500">
          {t?.quickLinks ?? "Quick Links"}
        </p>
        <ul class="mt-3 space-y-2 text-sm text-neutral-200">
          {
            quickLinks.map((link) => (
              <li>
                <a href={link.href} class="hover:text-white transition-colors">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500">
          {t?.contacts ?? "Contacts"}
        </p>
        <div class="mt-3 flex flex-col gap-3 text-xs md:text-sm">
          <a
            href={`mailto:${FOOTER_LINKS.email}`}
            class="flex items-center gap-2 text-neutral-200 hover:text-white transition-colors"
          >
            <Mail className="h-4 w-4" aria-hidden="true" />
            <span>Email</span>
          </a>
          <a
            href={FOOTER_LINKS.hug}
            class="flex items-center gap-2 text-neutral-200 hover:text-white transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            <HuggingFaceIcon class="h-4 w-4 fill-white" />
            <span>Hugging Face</span>
          </a>
          <a
            href={FOOTER_LINKS.github}
            class="flex items-center gap-2 text-neutral-200 hover:text-white transition-colors"
            target="_blank"
            rel="noopener noreferrer"
          >
            <GithubIcon class="h-4 w-4 fill-white" />
            <span>GitHub</span>
          </a>
        </div>
      </div>
    </div>
    <Separator className="my-6 bg-white/10" />
    <div
      class="flex flex-col gap-3 text-xs text-neutral-500 md:flex-row md:items-center md:justify-between"
    >
      <Copyright />
      <a href={FOOTER_LINKS.privacy} class="hover:text-white transition-colors">
        {t?.privacy ?? "Privacy Policy"}
      </a>
    </div>
  </div>
  <div
    class="absolute inset-x-0 bottom-0 h-12 bg-linear-to-t from-neutral-950 to-transparent opacity-60"
    aria-hidden="true"
  >
  </div>
</footer>
