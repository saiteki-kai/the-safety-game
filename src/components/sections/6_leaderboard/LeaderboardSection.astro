---
import IconLabel from "@components/common/IconLabel";
import type { LeaderboardContent } from "@content/types";
import SectionLayout from "@layouts/SectionLayout.astro";
import LeaderboardTable from "./Leaderboard";

const { leaderboard } = Astro.props as { leaderboard: LeaderboardContent };
const { title, description, emptyMessage } = leaderboard;
---

<SectionLayout
  id="leaderboard"
  title={title}
  description={description}
  sectionClass="bg-white"
>
  <div class="playground-card">
    <div class="playground-header">
      <div class="flex items-center gap-2">
        <IconLabel
          name="trophy"
          size={18}
          iconClass=""
          as="span"
          className="text-base font-medium"
        >
          {title}
        </IconLabel>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-right text-sm text-white hidden sm:block">
          <div class="text-sm text-white font-medium">
            Lo score più alto ottenuto dal tuo team è mostrato in classifica.
          </div>
        </div>
      </div>
    </div>

    <div class="leaderboard-root">
      <div
        class="table-scroll"
        role="region"
        aria-label="Leaderboard"
        tabindex="0"
      >
        <LeaderboardTable emptyMessage={emptyMessage} client:load />
      </div>
    </div>
  </div>
</SectionLayout>
