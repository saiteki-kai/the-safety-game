---
import IconLabel from "@components/common/IconLabel";
import SectionLayout from "@layouts/SectionLayout.astro";
import i18n from "i18next";
import LeaderboardTable from "./Leaderboard";

const IT_LEADERBOARD = {
  title: "Classifica",
  description: "Consulta la classifica delle squadre partecipanti in base ai punteggi ottenuti.",
  scoreNote: "I punteggi riportati corrispondono all'unsafety score medio dei prompt inviati.",
  emptyMessage: "La classifica sarà disponibile alla fine della competizione.",
};
---

<SectionLayout
  id="leaderboard"
  title={IT_LEADERBOARD.title}
  description={IT_LEADERBOARD.description}
  sectionClass="bg-white"
>
  <div class="playground-card">
    <div class="playground-header">
      <div class="flex items-center gap-2">
        <IconLabel
          name="trophy"
          size={18}
          iconClass=""
          as="span"
          className="text-base font-medium"
        >
          {IT_LEADERBOARD.title}
        </IconLabel>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-right text-sm text-white hidden sm:block">
          <div class="text-sm text-white font-medium">
            {IT_LEADERBOARD.scoreNote}
          </div>
        </div>
      </div>
    </div>

    <div class="leaderboard-root">
      <div
        class="table-scroll"
        role="region"
        aria-label={"Leaderboard"}
      >
        <LeaderboardTable
          emptyMessage={IT_LEADERBOARD.emptyMessage}
          client:idle
        />
      </div>
    </div>
  </div>
</SectionLayout>
