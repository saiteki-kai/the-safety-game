---
import IconLabel from "@components/common/IconLabel";
import SectionLayout from "@layouts/SectionLayout.astro";
import i18n from "i18next";
import LeaderboardTable from "./Leaderboard";
---

<SectionLayout
  id="leaderboard"
  title={i18n.t("leaderboard:title")}
  description={i18n.t("leaderboard:description")}
  sectionClass="bg-white"
>
  <div class="playground-card">
    <div class="playground-header">
      <div class="flex items-center gap-2">
        <IconLabel
          name="trophy"
          size={18}
          iconClass=""
          as="span"
          className="text-base font-medium"
        >
          {i18n.t("leaderboard:title")}
        </IconLabel>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-right text-sm text-white hidden sm:block">
          <div class="text-sm text-white font-medium">
            {i18n.t("leaderboard:scoreNote")}
          </div>
        </div>
      </div>
    </div>

    <div class="leaderboard-root">
      <div
        class="table-scroll"
        role="region"
        aria-label={"Leaderboard"}
      >
        <LeaderboardTable
          emptyMessage={i18n.t("leaderboard:emptyMessage")}
          client:load
        />
      </div>
    </div>
  </div>
</SectionLayout>
