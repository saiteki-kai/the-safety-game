---
import IconLabel from "@components/common/IconLabel";
import SectionLayout from "@layouts/SectionLayout.astro";
import type { LeaderboardContent } from "@/i18n/locales/types";
import LeaderboardTable from "./Leaderboard";

const { leaderboard } = Astro.props as { leaderboard: LeaderboardContent };
const { title, description, emptyMessage, scoreNote } = leaderboard;
const labels = {
  rank: leaderboard.rank,
  score: leaderboard.score,
  teamName: leaderboard.teamName,
  lastSubmission: leaderboard.lastSubmission,
  loadError: leaderboard.loadError,
};
---

<SectionLayout
  id="leaderboard"
  title={title}
  description={description}
  sectionClass="bg-white"
>
  <div class="playground-card">
    <div class="playground-header">
      <div class="flex items-center gap-2">
        <IconLabel
          name="trophy"
          size={18}
          iconClass=""
          as="span"
          className="text-base font-medium"
        >
          {title}
        </IconLabel>
      </div>

      <div class="flex items-center gap-4">
        <div class="text-right text-sm text-white hidden sm:block">
          <div class="text-sm text-white font-medium">
            {scoreNote}
          </div>
        </div>
      </div>
    </div>

    <div class="leaderboard-root">
      <div
        class="table-scroll"
        role="region"
        aria-label="Leaderboard"
      >
  <LeaderboardTable emptyMessage={emptyMessage} labels={labels} client:visible />
      </div>
    </div>
  </div>
</SectionLayout>
