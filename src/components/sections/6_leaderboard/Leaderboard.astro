---
import Icon from "@components/common/Icon.astro";
import IconLabel from "@components/common/IconLabel.astro";
import type { LeaderboardContent } from "@content/types";
import SectionLayout from "@layouts/SectionLayout.astro";
import { formatDateTime, formatNumber, formatTime } from "@utils/formatters";

const { leaderboard } = Astro.props as { leaderboard: LeaderboardContent };
const { teams, title, description, emptyMessage, lastUpdatedLabel, updatedAt } =
  leaderboard;
const hasTeams = teams && teams.length > 0;

// compute participant count (sum of members)
const participantCount = teams.reduce((sum, t) => {
  const members =
    typeof t.members === "number" ? t.members : Number(t.members ?? 0);
  return sum + (Number.isFinite(members) ? members : 0);
}, 0);

const formatPercent = (v: number) => {
  if (typeof v !== "number" || !Number.isFinite(v)) return "0.00";
  return (v * 100).toFixed(2);
};

// format like: 31 ott., 14:32 (day short-month, hour:minute) — no year
const formatDateShortNoYear = (value: string) => {
  try {
    return new Intl.DateTimeFormat("it-IT", {
      day: "2-digit",
      month: "short",
      hour: "2-digit",
      minute: "2-digit",
    }).format(new Date(value));
  } catch (e) {
    return formatDateTime(value);
  }
};

// highlight configuration for top ranks
const highlightConfig: Record<
  number,
  { row: string; icon?: { name: string; class: string } }
> = {
  1: { row: "highlight-1", icon: { name: "trophy", class: "text-yellow-500" } },
  2: { row: "highlight-2", icon: { name: "medal", class: "text-gray-400" } },
  3: { row: "highlight-3", icon: { name: "award", class: "text-amber-600" } },
};
---

<SectionLayout
  id="leaderboard"
  title={title}
  description={description}
  sectionClass="bg-white"
>
  <div class="playground-card">
    <!-- Top bar: same structure used in Playground => title at left, optional actions at right -->
    <div class="playground-header">
      <div class="flex items-center gap-2">
        <IconLabel
          name="trophy"
          size={18}
          iconClass=""
          as="span"
          class="text-base font-medium"
        >
          {title}
        </IconLabel>
      </div>

      <div class="flex items-center gap-4">
        <div class="hidden sm:flex items-center gap-6 text-sm">
          <div class="inline-flex items-center gap-2 text-white">
            <Icon name="users" size={16} class="text-white" />
            <span class="font-medium text-white">{participantCount}</span>
            <span class="text-white">Partecipanti</span>
            <!-- <span class="font-medium text-white">{teams.length}</span>
            <span class="text-white">Team</span> -->
          </div>
        </div>

        <div class="sm:hidden text-right text-sm text-white">
          <div class="text-sm text-white font-medium">
            {participantCount} Partecipanti
          </div>
          <!-- <div class="text-sm text-white font-medium">{teams.length} Team</div> -->
        </div>
        <div class="text-sm text-white text-right hidden sm:block">
          {lastUpdatedLabel}
          {formatTime(updatedAt)}
        </div>
      </div>
    </div>

    <!-- Table area: fixed height with vertical scroll; thead stays visible using position:sticky -->
    {
      hasTeams ? (
        <div class="leaderboard-root">
          <div
            class="table-scroll"
            role="region"
            aria-label="Leaderboard"
            tabindex="0"
          >
            <table class="table-base">
              <colgroup>
                <col style="width:5rem" />
                <col style="width:6rem" />
                <col style="width:5rem" />
                <col />
                <col style="width:10rem" />
              </colgroup>
              <thead>
                <tr>
                  <th scope="col" class="text-center">
                    Posizione
                  </th>
                  <th scope="col" class="text-center">
                    Punteggio
                  </th>
                  <th scope="col" class="text-center">
                    #Membri
                  </th>
                  <th scope="col" class="text-left">
                    Nome del Team
                  </th>
                  <th scope="col" class="text-right">
                    Ultima Consegna
                  </th>
                </tr>
              </thead>
              <tbody>
                {teams.map((team) => {
                  const highlight = highlightConfig[team.rank];
                  const rowClass = `leaderboard-row ${highlight?.row ?? ""} ${team.teamName === "ChatGPT" ? "chatgpt-row" : ""}`;
                  return (
                    <tr class={rowClass}>
                      <td class="td text-center text-neutral-500 rank-cell">
                        {highlight?.icon ? (
                          <div class="podium-icon">
                            <Icon
                              name={highlight.icon.name}
                              size={20}
                              class={highlight.icon.class}
                            />
                          </div>
                        ) : (
                          <div class="podium-icon">{team.rank}</div>
                        )}
                      </td>
                      <td class="td text-center score-mono font-medium">
                        {formatPercent(team.score)}
                      </td>
                      <td class="td text-center">{team.members}</td>
                      <td class="td team-name text-left">
                        {team.teamName === "ChatGPT" ? (
                          <IconLabel
                            name="chatgpt"
                            size={16}
                            iconClass="m-auto ml-1"
                            as="span"
                            position="end"
                            class="inline-flex items-center text-emerald-500 font-semibold"
                          >
                            {team.teamName}
                          </IconLabel>
                        ) : (
                          team.teamName
                        )}
                      </td>
                      <td class="td text-right text-neutral-500">
                        <time datetime={team.lastUpdated}>
                          {formatDateShortNoYear(team.lastUpdated)}
                        </time>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ) : (
        <IconLabel
          name="triangle-alert"
          size={28}
          iconClass="text-neutral-400"
          as="div"
          class="flex-col leaderboard-empty"
        >
          {emptyMessage}
        </IconLabel>
      )
    }
  </div>
</SectionLayout>

<style>
  .leaderboard-root {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .table-scroll {
    height: 460px;
    overflow: auto;
    -webkit-overflow-scrolling: touch;
    border-radius: var(--radius, 6px);
    border: none;
    background: var(--bg-white, #fff);
  }

  .table-base {
    width: 100%;
    border-collapse: separate;
    table-layout: auto;
    border-spacing: 0;
    min-width: 640px;
  }

  thead th {
    position: sticky;
    top: 0;
    /* stronger, slightly darker background for better separation */
    background-color: var(
      --surface-100,
      rgb(243 244 246 / var(--tw-bg-opacity, 1))
    );
    z-index: 5;
    padding: 0.85rem 1rem;
    text-align: left;
    font-weight: 700;
    font-size: 1rem;
    color: var(--nav-link, #0f172a);
    border-bottom: 1px solid rgba(15, 23, 42, 0.06);
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
  }

  .td,
  td {
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--color-border, rgba(16, 24, 40, 0.04));
    vertical-align: middle;
    font-size: 1rem;
    color: #0f172a; /* slightly darker for contrast */
    background: transparent;
    font-family: "Inter", "Segoe UI", Arial, sans-serif;
    font-weight: 400;
  }

  /* Ensure table body cells clip and truncate long content locally (moved from globals).
     Keep header cells free from max-width so column headers are never ellipsized. */
  .table-base td {
    box-sizing: border-box;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 0; /* allows ellipsis to work inside table layout */
  }

  .table-base th {
    box-sizing: border-box;
    overflow: visible;
    white-space: nowrap;
  }

  /* local utility: text-right (reintroduce if global utilities are purged) */
  thead th.text-right {
    text-align: right;
  }

  .team-name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rank-cell .podium-icon {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .leaderboard-row:hover td {
    background: rgba(15, 23, 42, 0.02);
  }

  .highlight-1 td {
    background: var(--warning-50, #fffbeb);
    border-bottom: 1px solid #fbbf24;
  }
  .highlight-2 td {
    background: var(--surface-100, #f8fafc);
    border-bottom: 1px solid #d1d5db;
  }
  .highlight-3 td {
    background: #fff7ed;
    border-bottom: 1px solid #fb923c;
  }

  /* ChatGPT row — stronger green background and borders to ensure visibility */
  .chatgpt-row td {
    background-color: var(--success-50, #ecfdf5);
    border-bottom: 1px solid var(--success-100, #bbf7d0);
  }

  /* Responsive tweaks */
  @media (max-width: 640px) {
    .table-base {
      min-width: 520px;
    }
    .table-scroll {
      height: 320px;
    }
  }
</style>
