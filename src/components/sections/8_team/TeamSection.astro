---
import MemberCard from "@components/common/MemberCard.astro";
import SectionLayout from "@layouts/SectionLayout.astro";
import TEAM_MEMBERS, { type Member } from "@/content/team";
import type { TeamMemberTranslation } from "@/lib/translations";

interface TeamSectionTranslations {
  title: string;
  description: string;
  members: Record<string, TeamMemberTranslation>;
}

interface Props {
  translations: TeamSectionTranslations;
}

const { translations: t } = Astro.props;

type LocalizedMember = Member & { role?: string; bio?: string };

const members: LocalizedMember[] = TEAM_MEMBERS.map((member) => {
  const translation = t.members[member.name] ?? {};

  return {
    ...member,
    ...translation,
  };
});
---

<SectionLayout
  id="team"
  title={t.title}
  description={t.description}
  sectionClass="section-gradient"
>
  <div class="team-grid">
    {
      members.map((member) => (
        <MemberCard member={member} size="md" showEmail class="h-full" />
      ))
    }
  </div>
</SectionLayout>
