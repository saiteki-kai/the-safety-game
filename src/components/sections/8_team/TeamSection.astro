---
import MemberCard from "@components/common/MemberCard.astro";
import SectionLayout from "@layouts/SectionLayout.astro";
import type { TeamContent } from "@/i18n/locales/types";

const { team } = Astro.props as { team: TeamContent };
---

<SectionLayout
  id="team"
  title={team.title}
  description={team.description}
  sectionClass="section-gradient"
>
  <div class="team-grid">
    {
      team.members.map((member) => (
        <MemberCard member={member} size="md" showEmail class="h-full" />
      ))
    }
  </div>
</SectionLayout>
