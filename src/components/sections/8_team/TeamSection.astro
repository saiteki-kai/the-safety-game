---
import MemberCard from "@components/common/MemberCard.astro";
import SectionLayout from "@layouts/SectionLayout.astro";
import i18n from "i18next";
import TEAM_MEMBERS, { type Member } from "@/content/team";

const translationMembers = i18n.t("team:members", {
  returnObjects: true,
}) as Record<string, Member>;

type LocalizedMember = Member & { role?: string; bio?: string };

const members: LocalizedMember[] = TEAM_MEMBERS.map((member) => {
  const translation = translationMembers[member.name] ?? {};

  return {
    ...member,
    ...translation,
  };
});
---

<SectionLayout
  id="team"
  title={i18n.t("team:title")}
  description={i18n.t("team:description")}
  sectionClass="section-gradient"
>
  <div class="team-grid">
    {
      members.map((member) => (
        <MemberCard member={member} size="md" showEmail class="h-full" />
      ))
    }
  </div>
</SectionLayout>
