---
import type { HomeContent } from "@/i18n/locales/types";

const { home } = Astro.props as { home: HomeContent };
---

<section id="home" class="hero-section hero-gradient hero-theme-cosmic">
  <div class="hero-content">
    <div class="hero-main">
      <div class="hero-main-top">
        <p class="hero-kicker">{home.kicker}</p>
        <p class="hero-description">
          {home.description}
        </p>
      </div>
      <div class="hero-title hero-title-block">
        <span class="hero-title-line hero-title-line--top">The</span>
        <span class="hero-title-line hero-title-line--bottom">
          <span class="hero-title-safety hero-title__highlight">Safety</span>
          <span class="hero-title-game">Game</span>
        </span>
      </div>
      <div class="hero-main-bottom">
        <span class="hero-dates">{home.eventDates}</span>
        <p class="hero-cta-text">{home.cta}</p>
      </div>
    </div>
  </div>
  <a href="#challenge" class="hero-indicator focus-ring">
    {home.learnMore}
    <span aria-hidden="true">↓</span>
  </a>
</section>
