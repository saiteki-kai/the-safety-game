---
import Card from "@components/common/Card.astro";
import Icon from "@components/common/Icon";
import SectionLayout from "@layouts/SectionLayout.astro";
import type { ParticipationContent } from "@/i18n/locales/types";

const { participation } = Astro.props as {
  participation: ParticipationContent;
};
---

<SectionLayout
  id="participate"
  title={participation.title}
  description={participation.intro}
  sectionClass="bg-white"
>

  <div class="grid grid-cols-1 gap-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <Card class="p-5 registration-card md:col-span-2 h-full" innerClass="h-full flex flex-col justify-between" label={participation.registration.label} icon="form" iconClass="text-blue-600 shrink-0">
        <p class="text-neutral-700 mb-2">
          {participation.registration.description}
        </p>
        <p class="text-neutral-700 mb-3">
          {participation.registration.afterLogin}
        </p>
      </Card>

      <Card class="p-5 md:col-span-1 h-full" innerClass="h-full flex flex-col" label={participation.privacy.label} icon="eye-off" iconClass="text-neutral-600 shrink-0">
        <p class="text-neutral-700 mb-2" set:html={participation.privacy.description}></p>
      </Card>
    </div>

    {
      participation.submission && (
  <Card class="p-5" label={participation.submission.label} icon="upload" iconClass="text-blue-600 shrink-0">
          <p
            class="text-neutral-700 mb-3"
            set:html={participation.submission.howItWorks}
          />

          {participation.submission.warning && (
            <div class="code-snippet bg-yellow-50 border-yellow-200 text-yellow-800 px-4 py-3 rounded mt-3">
              <div class="flex items-start gap-3">
                <span class="shrink-0">
                  <Icon name="triangle-alert" size={20} className="text-yellow-700" />
                </span>
                <span class="text-sm">{participation.submission.warning}</span>
              </div>
            </div>
          )}
        </Card>
      )
    }

    {
      participation.evaluation && (
  <Card class="p-5" label={participation.evaluation.label} icon="star" iconClass="text-yellow-600 shrink-0">
          <p class="text-neutral-700 mb-2">
            {participation.evaluation.overview}
          </p>
          <p class="text-neutral-700">{participation.evaluation.scoring}</p>
        </Card>
      )
    }
  </div>
</SectionLayout>
