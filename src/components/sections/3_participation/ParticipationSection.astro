---
import Card from "@components/common/Card.astro";
import Icon from "@components/common/Icon";
import { Rocket } from "lucide-react";
import SectionLayout from "@layouts/SectionLayout.astro";

interface ParticipationTranslations {
  title: string;
  intro: string;
  registrationLabel: string;
  registrationDescription: string;
  registrationDetails: string;
  privacyLabel: string;
  privacyDescription: string;
  playgroundLabel: string;
  playgroundDescription: string;
  submissionLabel: string;
  submissionDescription: string;
  submissionWarning: string;
  evaluationLabel: string;
  evaluationDescription: string;
}

interface Props {
  translations: ParticipationTranslations;
  privacyUrl: string;
}

const { translations: t, privacyUrl } = Astro.props;
---

<SectionLayout
  id="participate"
  title={t.title}
  description={t.intro}
  sectionClass="bg-white"
>
  <div class="grid grid-cols-1 gap-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card
        class="p-5 registration-card md:col-span-2 h-full"
        innerClass="h-full flex flex-col justify-between"
        label={t.registrationLabel}
        icon="form"
        iconClass="text-blue-600 shrink-0"
      >
        <p class="text-neutral-700 mb-2">
          {t.registrationDescription}
        </p>
        <p class="text-neutral-700 mb-3">
          {t.registrationDetails}
        </p>
      </Card>

      <Card
        class="p-5 md:col-span-1 h-full"
        innerClass="h-full flex flex-col"
        label={t.privacyLabel}
        icon="eye-off"
        iconClass="text-neutral-600 shrink-0"
      >
        <p class="text-neutral-700 mb-2">
          {t.privacyDescription} <a href={privacyUrl} class="text-blue-600 hover:underline">Leggi il regolamento</a>
        </p>
      </Card>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <Card
        class="p-5"
        label={t.playgroundLabel}
        icon={Rocket}
        iconClass="text-purple-600 shrink-0"
      >
        <p class="text-neutral-700 leading-relaxed">
          {t.playgroundDescription}
        </p>
      </Card>

      <Card
        class="p-5"
        label={t.submissionLabel}
        icon="upload"
        iconClass="text-blue-600 shrink-0"
      >
        <p
          class="text-neutral-700 mb-3"
          set:html={t.submissionDescription}
        />

        <div
          class="code-snippet bg-yellow-50 border-yellow-200 text-yellow-800 px-4 py-3 rounded mt-3"
        >
          <div class="flex items-start gap-3">
            <span class="shrink-0">
              <Icon name="triangle-alert" size={20} className="text-yellow-700" />
            </span>
            <span class="text-sm">
              {t.submissionWarning}
            </span>
          </div>
        </div>
      </Card>
    </div>

    <Card
      class="p-5"
      label={t.evaluationLabel}
      icon="star"
      iconClass="text-yellow-600 shrink-0"
    >
      <p class="text-neutral-700 mb-2" set:html={t.evaluationDescription} />
    </Card>
  </div>
</SectionLayout>
