---
import Card from "@components/common/Card.astro";
import Icon from "@components/common/Icon";
import SectionLayout from "@layouts/SectionLayout.astro";
import i18n from "i18next";
---

<SectionLayout
  id="participate"
  title={i18n.t("participation:title")}
  description={i18n.t("participation:intro")}
  sectionClass="bg-white"
>
  <div class="grid grid-cols-1 gap-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <Card
        class="p-5 registration-card md:col-span-2 h-full"
        innerClass="h-full flex flex-col justify-between"
        label={i18n.t("participation:registration.label")}
        icon="form"
        iconClass="text-blue-600 shrink-0"
      >
        <p class="text-neutral-700 mb-2">
          {i18n.t("participation:registration.description")}
        </p>
        <p class="text-neutral-700 mb-3">
          {i18n.t("participation:registration.details")}
        </p>
      </Card>

      <Card
        class="p-5 md:col-span-1 h-full"
        innerClass="h-full flex flex-col"
        label={i18n.t("participation:privacy.label")}
        icon="eye-off"
        iconClass="text-neutral-600 shrink-0"
      >
        <p
          class="text-neutral-700 mb-2"
          set:html={i18n.t("participation:privacy.description")}
        />
      </Card>
    </div>

    <Card
      class="p-5"
      label={i18n.t("participation:submission.label")}
      icon="upload"
      iconClass="text-blue-600 shrink-0"
    >
      <p
        class="text-neutral-700 mb-3"
        set:html={i18n.t("participation:submission.description")}
      />

      <p class="text-neutral-700 mb-3">
        {i18n.t("participation:submission.details")}
      </p>

      <div
        class="code-snippet bg-yellow-50 border-yellow-200 text-yellow-800 px-4 py-3 rounded mt-3"
      >
        <div class="flex items-start gap-3">
          <span class="shrink-0">
            <Icon name="triangle-alert" size={20} className="text-yellow-700" />
          </span>
          <span class="text-sm">
            {i18n.t("participation:submission.warning")}
          </span>
        </div>
      </div>
    </Card>

    <Card
      class="p-5"
      label={i18n.t("participation:evaluation.label")}
      icon="star"
      iconClass="text-yellow-600 shrink-0"
    >
      <p class="text-neutral-700 mb-2">
        {i18n.t("participation:evaluation.description")}
      </p>
      <p class="text-neutral-700">
        {i18n.t("participation:evaluation.details")}
      </p>
    </Card>
  </div>
</SectionLayout>
