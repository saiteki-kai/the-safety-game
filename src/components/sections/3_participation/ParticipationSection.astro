---
import Card from "@components/common/Card.astro";
import Icon from "@components/common/Icon";
import type { ParticipationContentExtended } from "@content/types";
import SectionLayout from "@layouts/SectionLayout.astro";

const { participation } = Astro.props as {
  participation: ParticipationContentExtended;
};
---

<SectionLayout
  id="participate"
  title={participation.title}
  description={participation.intro}
  sectionClass="bg-white"
>

  <div class="grid grid-cols-1 gap-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
  <Card class="p-5 registration-card md:col-span-2 h-full" innerClass="h-full flex flex-col justify-between" label="Registrazione" icon="form" iconClass="text-blue-600 shrink-0">
        <p class="text-neutral-700 mb-2">
          I team possono essere composti da 1 a 4 persone. Ogni membro del team deve registrarsi con la propria email universitaria per partecipare alla challenge.
        </p>
        <p class="text-neutral-700 mb-3">
          Dopo l'accesso potrai accedere alla dashboard del tuo team.
        </p>
        <div class="flex justify-center">
          <a class="btn btn-primary registration-cta mx-auto" href="/login">
            Registrati
          </a>
        </div>
      </Card>

      <Card class="p-5 md:col-span-1 h-full" innerClass="h-full flex flex-col" label="Privacy" icon="eye-off" iconClass="text-neutral-600 shrink-0">
        <p class="text-neutral-700 mb-2">
          La partecipazione alla challenge implica l'integrale accettazione del <a href="/privacy" class="text-blue-600 hover:underline">regolamento e delle linee guida operative </a> della stessa.
        </p>
      </Card>
    </div>

    {
      participation.submission && (
  <Card class="p-5" label="Submission" icon="upload" iconClass="text-blue-600 shrink-0">
          <p
            class="text-neutral-700 mb-3"
            set:html={participation.submission.howItWorks}
          />

          {participation.submission.warning && (
            <div class="code-snippet bg-yellow-50 border-yellow-200 text-yellow-800 px-4 py-3 rounded mt-3">
              <div class="flex items-start gap-3">
                <span class="shrink-0">
                  <Icon name="triangle-alert" size={20} className="text-yellow-700" />
                </span>
                <span class="text-sm">{participation.submission.warning}</span>
              </div>
            </div>
          )}
        </Card>
      )
    }

    {
      participation.evaluation && (
  <Card class="p-5" label="Valutazione" icon="star" iconClass="text-yellow-600 shrink-0">
          <p class="text-neutral-700 mb-2">
            {participation.evaluation.overview}
          </p>
          <p class="text-neutral-700">{participation.evaluation.scoring}</p>
        </Card>
      )
    }
  </div>
</SectionLayout>
