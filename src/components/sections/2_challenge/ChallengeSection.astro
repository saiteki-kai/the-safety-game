---
import Card from "@components/common/Card.astro";
import type { ChallengeContent } from "@content/types";
import SectionLayout from "@layouts/SectionLayout.astro";

const { challenge } = Astro.props as { challenge: ChallengeContent };
---

<SectionLayout
  id="challenge"
  title={challenge.title}
  description={challenge.description}
  sectionClass="bg-white"
>
  <div class="space-y-8">
    <div class="py-8">
      <p class="gradient-text text-center text-3xl sm:text-4xl font-semibold mb-0">Crea prompt basati sul contesto culturale italiano, capaci di spingere l’IA a generare contenuti non sicuri o inappropriati.</p>
    </div>

    <Card
      class="p-6"
      label="Obiettivo"
      icon="lightbulb"
      iconClass="text-rose-600 shrink-0"
    >
      <div class="space-y-2">
        {
          challenge.what
            .split(/(?<=[.!?])\s+/)
            .map((sentence) => {
              const isHighlight = sentence.includes("Crea prompt basati sul contesto culturale italiano");
              return (
                <p class={"text-neutral-700 leading-relaxed " + (isHighlight ? "text-rose-400 font-semibold text-lg" : "")}>{isHighlight ? <span>{sentence}</span> : sentence}</p>
              );
            })
        }
      </div>
    </Card>
    
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <Card
        class="p-6"
        label="Riuscerai a battere ChatGPT?"
        icon="star"
        iconClass="text-yellow-400 shrink-0"
      >
        <p class="text-neutral-700 leading-relaxed mb-4">
          {challenge.challenge}
        </p>
      </Card>

      <Card
        class="p-6"
        label="Chiunque può partecipare!"
        icon="users"
        iconClass="text-green-600 shrink-0"
      >
        <p class="text-neutral-700 leading-relaxed">
          {challenge.participation}
        </p>
      </Card>
      
      <Card
        class="p-6"
        label="Premi"
        icon="trophy"
        iconClass="text-amber-600 shrink-0"
      >
        <p class="text-neutral-700 leading-relaxed">
          Il team che produrrà i migliori prompt verrà premiato davanti al Collegio Docenti del dipartimento di Informatica di Milano-Bicocca. <br> A tutti i partecipanti verrà rilasciato un certificato di partecipazione.
        </p>
      </Card>
    </div>
    
    <Card
      class="p-6"
      label={`Cos'è un Large Language Model?`}
      icon="ai"
      iconClass="text-blue-600 shrink-0"
    >
      <div class="space-y-4">
        {
          challenge.introduction.map((paragraph) => (
            <p class="text-neutral-700 leading-relaxed">{paragraph.content}</p>
          ))
        }
      </div>
    </Card>
  </div>
</SectionLayout>
