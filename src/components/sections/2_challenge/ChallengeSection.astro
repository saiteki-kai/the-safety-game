---
import Card from "@components/common/Card.astro";
import SectionLayout from "@layouts/SectionLayout.astro";

interface ChallengeIntroductionParagraph {
  content: string;
}

interface ChallengeTranslations {
  title: string;
  description: string;
  tagline: string;
  what: string;
  objectiveLabel: string;
  challengeLabel: string;
  challengeText: string;
  participationLabel: string;
  participation: string;
  prizesLabel: string;
  prizesDescription: string;
  llmLabel: string;
  introduction: ChallengeIntroductionParagraph[];
  webinarLabel: string;
  webinarText: string;
}

interface Props {
  translations: ChallengeTranslations;
}

const { translations: t } = Astro.props;
---

<SectionLayout
  id="challenge"
  title={t.title}
  description={t.description}
  sectionClass="bg-white"
>
  <div class="space-y-8">
    <div class="py-8">
      <p
        class="gradient-text text-center text-3xl sm:text-4xl font-semibold mb-0"
      >
        {t.tagline}
      </p>
    </div>

    <Card
      class="p-6"
      label={t.objectiveLabel}
      icon="lightbulb"
      iconClass="text-rose-600 shrink-0"
    >
      <div class="space-y-2">
        {
          t.what
            .split(/(?<=[.!?])\s+/)
            .map((sentence: string) => {
              return <p class="text-neutral-700 leading-relaxed">{sentence}</p>;
            })
        }
      </div>
    </Card>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <Card
        class="p-6"
        label={t.challengeLabel}
        icon="star"
        iconClass="text-yellow-400 shrink-0"
      >
        <p class="text-neutral-700 leading-relaxed mb-4">
          {t.challengeText}
        </p>
      </Card>

      <Card
        class="p-6"
        label={t.participationLabel}
        icon="users"
        iconClass="text-green-600 shrink-0"
      >
        <p class="text-neutral-700 leading-relaxed">
          {t.participation}
        </p>
      </Card>

      <Card
        class="p-6"
        label={t.prizesLabel}
        icon="trophy"
        iconClass="text-amber-600 shrink-0"
      >
        <p
          class="text-neutral-700 leading-relaxed"
          set:html={t.prizesDescription}
        />
      </Card>
    </div>

    <Card
      class="p-6"
      label={t.llmLabel}
      icon="ai"
      iconClass="text-blue-600 shrink-0"
    >
      <div class="space-y-4">
        {
          t.introduction.map((paragraph) => (
            <p class="text-neutral-700 leading-relaxed">{paragraph.content}</p>
          ))
        }
      </div>
    </Card>

    <Card
      class="p-6"
      label={t.webinarLabel}
      icon="clock"
      iconClass="text-indigo-600 shrink-0"
    >
      <p class="text-neutral-700 leading-relaxed">
        {t.webinarText}
      </p>
    </Card>
  </div>
</SectionLayout>
