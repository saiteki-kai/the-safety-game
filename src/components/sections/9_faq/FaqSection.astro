---
import type { FaqContent } from "@/i18n/locales/types";
import SectionLayout from "@layouts/SectionLayout.astro";
import FaqAccordion from "./FaqAccordion";

const { faqs } = Astro.props as { faqs: FaqContent };
---

<SectionLayout
  id="faq"
  title={faqs.title}
  description={faqs.description}
  sectionClass="bg-white"
>
  <div class="max-w-3xl mx-auto">
    <FaqAccordion client:idle items={faqs.items} />
  </div>
</SectionLayout>
