---
import SectionLayout from "@layouts/SectionLayout.astro";
import FaqAccordion from "./FaqAccordion";
import type { FaqItem } from "@/lib/translations";

interface FaqTranslations {
  title: string;
  description: string;
  items: FaqItem[];
}

interface Props {
  translations: FaqTranslations;
}

const { translations: t } = Astro.props;
---

<SectionLayout
  id="faq"
  title={t.title}
  description={t.description}
  sectionClass="bg-white"
>
  <div class="max-w-3xl mx-auto">
    <FaqAccordion client:idle items={t.items} />
  </div>
</SectionLayout>
