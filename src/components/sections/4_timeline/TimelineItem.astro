---
import Icon from "@components/common/Icon";
import type { TimelineEntry } from "@/content/timeline";
import type { IconName } from "@/lib/icons";

interface Props {
  entry: TimelineEntry;
  iconName: IconName;
  indicatorClass: string;
  iconClass: string;
  dateClass: string;
  hasNext: boolean;
}

const { entry, iconName, indicatorClass, iconClass, dateClass, hasNext } = Astro.props;

const isCompleted = entry.status === "completed";
---

<li class="timeline-item overflow-visible">
  <div class="timeline-meta hidden sm:flex sm:flex-col sm:items-end">
    <time class={`timeline-date ${dateClass}`}>
      {entry.date}
    </time>
    {
      entry.time && (
        <span class={`timeline-time ${dateClass}`}>{entry.time}</span>
      )
    }
  </div>

  <div class="timeline-indicator-wrapper relative shrink-0 flex flex-col items-center h-full">
    {
      hasNext && (
        <div
          class={`timeline-connector ${isCompleted ? "w-1 bg-blue-400 shadow-sm z-20" : "border-l-4 border-dashed border-blue-100 z-10"}`}
          aria-hidden="true"
        />
      )
    }
    <span class={`${indicatorClass} z-30`}>
      <Icon
        name={iconName}
        size={24}
        className={`timeline-icon ${iconClass}`}
      />
    </span>
  </div>

  <div class="space-y-2 flex-1">
    {/* Mobile: show date/time above title, keep left meta for larger screens */}
    <div class="timeline-meta-mobile block sm:hidden text-sm text-gray-500">
      <time class={`timeline-date ${dateClass} block`}>
        {entry.date}
      </time>
      {
        entry.time && (
          <span class={`timeline-time ${dateClass} block`}>{entry.time}</span>
        )
      }
    </div>

    <h3 class="timeline-title">
      {entry.title}
    </h3>

    <p class="timeline-description">
      {entry.description}
    </p>
  </div>
</li>
