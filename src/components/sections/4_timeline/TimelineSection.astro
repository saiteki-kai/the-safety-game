---
import SectionLayout from "@layouts/SectionLayout.astro";
import i18n from "i18next";
import {
  TIMELINE_EVENTS,
  type TimelineEntry,
  type TimelineStatus,
} from "@/content/timeline";
import TimelineItem from "./TimelineItem.astro";

const now = new Date();
const computeStatus = (eventDate: Date): TimelineStatus => {
  return eventDate <= now ? "completed" : "upcoming";
};

// Format date using Intl API
const formatDate = (date: Date): string => {
  try {
    return new Intl.DateTimeFormat(i18n.language, {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(date);
  } catch {
    return date.toISOString().split("T")[0];
  }
};

const eventContent = i18n.t("dates:events", { returnObjects: true });

const timeline: TimelineEntry[] = TIMELINE_EVENTS.map((event) => {
  const content = eventContent[event.key] || { title: "", description: "" };

  return {
    date: formatDate(event.date),
    time: event.time,
    title: content.title,
    description: content.description,
    status: computeStatus(event.date),
  };
});

// Status configuration
const STATUS_CONFIG: Record<
  TimelineStatus,
  {
    icon: string;
    indicator: string;
    iconColor: string;
    dateColor: string;
  }
> = {
  completed: {
    icon: "circle-check",
    indicator: "timeline-indicator--gradient text-white ring-2 ring-blue-200",
    iconColor: "text-white",
    dateColor: "text-blue-300",
  },
  upcoming: {
    icon: "circle",
    indicator: "bg-white text-blue-400 ring-1 ring-inset ring-blue-100",
    iconColor: "text-blue-400",
    dateColor: "text-blue-500",
  },
};

const getEntryConfig = (status: TimelineStatus) => ({
  ...STATUS_CONFIG[status],
  indicatorClass: `timeline-indicator ${STATUS_CONFIG[status].indicator}`,
});
---

<SectionLayout
  id="dates"
  title={i18n.t("dates:title")}
  sectionClass="section-gradient"
>
  <div class="relative mx-auto max-w-3xl">
    <ol class="relative pl-6 sm:pl-10" role="list">
      {
        timeline.length === 0 ? (
          <li class="text-sm text-neutral-500">
            {i18n.t("dates:emptyMessage")}
          </li>
        ) : (
          timeline.map((entry, index) => {
            const config = getEntryConfig(entry.status);
            const hasNext = index < timeline.length - 1;

            return (
              <TimelineItem
                entry={entry}
                iconName={config.icon}
                indicatorClass={config.indicatorClass}
                iconClass={config.iconColor}
                dateClass={config.dateColor}
                hasNext={hasNext}
              />
            );
          })
        )
      }
    </ol>
  </div>
</SectionLayout>
