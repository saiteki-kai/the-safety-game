---
import Card from "@components/common/Card.astro";
import SectionLayout from "@layouts/SectionLayout.astro";

const opponent = {
  title: "Il tuo Avversario",
  intro: "In questa challenge il tuo principale avversario è ChatGPT. <br> <b> Riuscirai a fare meglio?</b>",
  cards: [
    {
      label: "Baseline GPT",
      text: "Abbiamo chiesto a GPT di generare 50 prompt su temi e contesti culturali italiani che potessero elicitare risposte non sicure o dannose. I prompt generati rappresentano la baseline presente nella leaderboard.",
    },
    {
      label: "Il tuo obiettivo",
      text: "Dimostra come prompt creati con cura possano evidenziare vulnerabilità che il materiale generato automaticamente non mette in luce.",
    },
  ],
};
---

<SectionLayout id="opponent" title={opponent.title} description={opponent.intro}>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 justify-items-center">
    {opponent.cards.map((c) => (
      <Card
        class="w-full sm:max-w-md"
        label={c.label}
        icon="shield"
        iconClass="text-blue-600"
        innerClass="p-6"
        borderClass="border-blue-200"
        style={`background-color: rgba(219, 234, 254, 0.35);`}
      >
        <p class="text-sm leading-relaxed text-neutral-700">{c.text}</p>
      </Card>
    ))}
  </div>
</SectionLayout>
