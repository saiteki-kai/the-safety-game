---
import "@styles/dashboard.css";

import PageLayout from "@layouts/PageLayout.astro";
import DashboardNav from "@/components/common/DashboardNav";
import FooterWithProps from "@/components/common/FooterWithProps.astro";
import { FinalSubmissionSection } from "@/components/dashboard/final/FinalSubmissionSection";
import { getTeamSubmissions } from "@/db/submissions";
import { getTeamByUserId } from "@/db/teams";
import { serverClient } from "@/lib/supabase";

const locale = "it";
const supabase = serverClient(Astro);
const profile = Astro.locals.user;
if (!profile) {
  return Astro.redirect("/login");
}
const team = await getTeamByUserId(supabase, profile.id);

if (!team) {
  return Astro.redirect("/setup");
}

// Check if the team has already made a final submission
const submissions = await getTeamSubmissions(supabase, team.id);
const finalSubmissionDone = submissions?.some((s) => !s.playground) ?? false;

const navMenu = [
  { title: "Home", url: "/it/home" },
  { title: "Dashboard", url: "/it/dashboard" },
];

const footerTranslations = {
  tagline: "Una challenge di prompt engineering etico che ti invita a misurare la sicurezza dei modelli linguistici italiani.",
  quickLinks: "Link Rapidi",
  contacts: "Contatti",
  privacy: "Privacy Policy",
};
---

<PageLayout title="Invio Finale | The Safety Game" lang={locale}>
  <DashboardNav client:load profile={profile} menu={navMenu} locale={locale} />
  <main class="flex min-h-0 w-full flex-1 flex-col my-12 gap-8 px-4 py-6 sm:px-8 sm:py-10" aria-label="Invio Finale">
    <div class="mx-auto w-full lg:container">
      <FinalSubmissionSection client:load teamId={team.id} disabled={finalSubmissionDone} locale={locale} />
    </div>
  </main>
  <FooterWithProps 
    slot="footer" 
    translations={footerTranslations}
    privacyUrl="/it/privacy"
    homeUrl="/it/home"
    dashboardUrl="/it/dashboard"
  />
</PageLayout>
