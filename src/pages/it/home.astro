---
import FooterWithProps from "@components/common/FooterWithProps.astro";
import LandingNavigation from "@components/common/LandingNavigation";
import {
  ChallengeSection,
  FaqSection,
  HeroSection,
  InstructionsSection,
  LeaderboardSection,
  LogosSection,
  ParticipationSection,
  TeamSection,
  TimelineSection,
} from "@components/sections";
import PageLayout from "@layouts/PageLayout.astro";
import {
  getTranslations,
  heroTranslations,
  challengeTranslations,
  participationTranslations,
  timelineTranslations,
  instructionsTranslations,
  faqTranslations,
  teamSectionTranslations,
  leaderboardTranslations,
} from "@/lib/translations";

const locale = "it";
const profile = Astro.locals.user;

// Get all translations for IT locale
const heroT = getTranslations(heroTranslations, locale);
const challengeT = getTranslations(challengeTranslations, locale);
const participationT = getTranslations(participationTranslations, locale);
const timelineT = getTranslations(timelineTranslations, locale);
const instructionsT = getTranslations(instructionsTranslations, locale);
const faqT = getTranslations(faqTranslations, locale);
const teamT = getTranslations(teamSectionTranslations, locale);
const leaderboardT = getTranslations(leaderboardTranslations, locale);

const footerTranslations = {
  tagline: "Una challenge di prompt engineering etico che ti invita a misurare la sicurezza dei modelli linguistici italiani.",
  quickLinks: "Link Rapidi",
  contacts: "Contatti",
  privacy: "Privacy Policy",
};
---

<PageLayout title="The Safety Game" description="The Safety Game - Hackathon organizzato da MIND, Università di Milano Bicocca" lang={locale}>
  <LandingNavigation slot="navigation" client:load profile={profile} locale={locale} />
  <HeroSection translations={heroT} />
  <!-- Invisible spacer so nav de-highlights when scrolling above the first real section -->
  <div id="top-spacer" aria-hidden="true" class="h-px -mt-px"></div>
  <ChallengeSection translations={challengeT} />
  <InstructionsSection translations={instructionsT} />
  <ParticipationSection translations={participationT} privacyUrl="/it/privacy" />
  <TimelineSection translations={timelineT} locale={locale} />
  <LeaderboardSection translations={leaderboardT} locale={locale} />
  <TeamSection translations={teamT} />
  <FaqSection translations={faqT} />
  <LogosSection slot="prefooter" />
  <FooterWithProps 
    slot="footer" 
    translations={footerTranslations}
    privacyUrl="/it/privacy"
    homeUrl="/it/home"
    dashboardUrl="/it/dashboard"
  />
</PageLayout>
