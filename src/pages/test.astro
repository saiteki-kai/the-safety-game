---
import DataFetcher from "../components/DataFetcher.jsx";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Supabase SSG</title>
  </head>
  <body>
    <main>
      <h1>Supabase Data</h1>
      <DataFetcher client:load />
    </main>
  </body>
</html>

<style>
  body {
    font-family: system-ui, sans-serif;
    max-width: 800px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  h1 {
    margin-bottom: 1.5rem;
  }

  :global(.container) {
    background: #f5f5f5;
    padding: 1.5rem;
    border-radius: 8px;
  }

  :global(button) {
    background: #3b82f6;
    color: white;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: 4px;
    cursor: pointer;
    margin-bottom: 1rem;
  }

  :global(button:hover:not(:disabled)) {
    background: #2563eb;
  }

  :global(button:disabled) {
    background: #ccc;
    cursor: not-allowed;
  }

  :global(pre) {
    background: white;
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
  }
</style>
