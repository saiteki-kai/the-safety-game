---
import FooterWithProps from "@components/common/FooterWithProps.astro";
import LandingNavigation from "@components/common/LandingNavigation";
import {
  ChallengeSection,
  FaqSection,
  HeroSection,
  InstructionsSection,
  LeaderboardSection,
  LogosSection,
  ParticipationSection,
  TeamSection,
  TimelineSection,
} from "@components/sections";
import PageLayout from "@layouts/PageLayout.astro";
import { I18nContextProvider } from "@/components/providers/I18nContext";

const profile = Astro.locals.user;

const footerTranslations = {
  tagline: "Una competizione di prompt engineering etico organizzata dal laboratorio di ricerca in AI Safety.",
  quickLinks: "Link Rapidi",
  contacts: "Contatti",
  privacy: "Privacy Policy",
};
---

<PageLayout title="The Safety Game" description="The Safety Game - Hackathon organizzato da MIND, Università di Milano Bicocca">
  <I18nContextProvider client:load locale="it">
    <LandingNavigation slot="navigation" client:load profile={profile} />
  </I18nContextProvider>
  <HeroSection />
  <!-- Invisible spacer so nav de-highlights when scrolling above the first real section -->
  <div id="top-spacer" aria-hidden="true" class="h-px -mt-px"></div>
  <ChallengeSection />
  <InstructionsSection />
  <ParticipationSection />
  <TimelineSection />
  <!--<LeaderboardSection />-->
  <TeamSection />
  <FaqSection />
  <LogosSection slot="prefooter" />
  <FooterWithProps 
    slot="footer" 
    translations={footerTranslations}
    privacyUrl="/privacy"
    homeUrl="/home"
    dashboardUrl="/dashboard"
  />
</PageLayout>
