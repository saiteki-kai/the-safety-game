---
import Google from "@assets/icons/google.svg";
import PageLayout from "@layouts/PageLayout.astro";
import { serverClient } from "@/lib/supabase";

const locale = "en";
const supabase = serverClient(Astro);
const { data } = await supabase.auth.getClaims();

if (data?.claims) {
  return Astro.redirect("/en/dashboard");
}
---

<PageLayout
  title="Sign In | The Safety Game"
  description="Sign in to The Safety Game"
  lang={locale}
>
  <div
    class="hero-section hero-gradient hero-theme-cosmic relative min-h-dvh"
  >
    <!-- Centered login card -->
    <div class="relative z-10 flex items-center justify-center min-h-dvh">
      <div class="w-full max-w-[500px] p-6 mt-24">
        <div
          class="w-full bg-white/95 backdrop-blur-md rounded-2xl py-6 px-6 shadow-xl ring-1 ring-neutral-200"
        >
          <div class="text-center mb-6">
            <h1 class="text-xl md:text-2xl font-bold text-neutral-900 mb-2">
              Sign in to participate
            </h1>
            <p class="text-sm text-neutral-600">
              Use your university account (@campus.unimib.it)
            </p>
          </div>

          <form
            method="post"
            action="/api/auth/signin"
            data-astro-reload
            class="space-y-4"
          >
            <input type="hidden" name="locale" value="en" />
            <input type="hidden" name="provider" value="google" />
            <button
              type="submit"
              class="w-full h-11 flex items-center justify-center gap-2 px-4 py-2 bg-white border border-neutral-300 rounded-lg text-neutral-700 font-medium shadow-sm hover:bg-neutral-50 hover:border-neutral-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all cursor-pointer"
            >
              <Google class="h-5 w-5" />

              <span>Continue with Google</span>
            </button>
          </form>
        </div>

        <div class="bottom-8 pt-4 left-0 right-0 z-10">
          <p class="text-center">
            <a
              href="/en/home"
              class="text-sm text-white/80 hover:text-white transition-colors"
              >← Back to home</a
            >
          </p>
        </div>
      </div>
    </div>
    <!-- subtle page-specific overlay (above background pseudo-elements, below content) -->
    <div class="login-overlay" aria-hidden="true"></div>
  </div>
</PageLayout>

<style>
  /* Darken the global hero slightly for the login page only */
  .login-overlay {
    position: absolute;
    inset: 0;
    z-index: -1; /* sits above hero pseudo elements but below z-10 content */
    background: linear-gradient(rgba(6, 8, 18, 0.45), rgba(6, 8, 18, 0.45));
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .login-overlay {
      background: linear-gradient(rgba(6, 8, 18, 0.55), rgba(6, 8, 18, 0.55));
    }
  }
</style>
