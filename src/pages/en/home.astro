---
import Footer from "@components/common/Footer.astro";
import LandingNavigation from "@components/common/LandingNavigation";
import {
  ChallengeSection,
  FaqSection,
  HeroSection,
  InstructionsSection,
  LeaderboardSection,
  LogosSection,
  ParticipationSection,
  TeamSection,
  TimelineSection,
} from "@components/sections";
import PageLayout from "@layouts/PageLayout.astro";

const profile = Astro.locals.user;
---

<PageLayout title="The Safety Game" >
  <LandingNavigation slot="navigation" client:load profile={profile} />
  <HeroSection />
  <!-- Invisible spacer so nav de-highlights when scrolling above the first real section -->
  <div id="top-spacer" aria-hidden="true" class="h-px -mt-px"></div>
  <ChallengeSection />
  <InstructionsSection />
  <ParticipationSection />
  <TimelineSection />
  <LeaderboardSection />
  <!-- <PlaygroundSection playground={content.playground} /> -->
  <TeamSection />
  <FaqSection />
  <LogosSection slot="prefooter" />
  <Footer slot="footer" />
</PageLayout>
</PageLayout>
