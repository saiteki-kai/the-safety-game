---
export const prerender = false;

import "@styles/dashboard.css";

import PageLayout from "@layouts/PageLayout.astro";
import DashboardNav from "@/components/common/DashboardNav";
import Footer from "@/components/common/Footer.astro";
import { FinalSubmissionSection } from "@/components/dashboard/final/FinalSubmissionSection";
import { footerQuickLinks } from "@/content/site-config";
import { getTeamSubmissions } from "@/db/submissions";
import { getTeamByUserId } from "@/db/teams";
import { localizeUrl } from "@/i18n/utils";
import { serverClient } from "@/lib/supabase";

const supabase = serverClient(Astro);
const profile = Astro.locals.user;
if (!profile) {
  return Astro.redirect(localizeUrl("/login"));
}
const team = await getTeamByUserId(supabase, profile.id);

if (!team) {
  return Astro.redirect(localizeUrl("/setup"));
}

// Check if the team has already made a final submission
const submissions = await getTeamSubmissions(supabase, team.id);
const finalSubmissionDone = submissions?.some((s) => !s.playground) ?? false;

const navMenu = [
  { title: "Home", url: localizeUrl("/home") },
  { title: "Dashboard", url: localizeUrl("/dashboard") },
];
---

<PageLayout title="Final Submission | The Safety Game">
  <DashboardNav client:load profile={profile} menu={navMenu} />
  <main class="flex min-h-0 w-full flex-1 flex-col my-12 gap-8 px-4 py-6 sm:px-8 sm:py-10" aria-label="Final submission">
    <div class="mx-auto w-full lg:container">
      <FinalSubmissionSection client:load teamId={team.id} disabled={finalSubmissionDone} />
    </div>
  </main>
  <Footer slot="footer" quickLinks={footerQuickLinks} />
</PageLayout>
