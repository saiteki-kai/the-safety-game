---
export const prerender = false;

import PageLayout from "../layouts/PageLayout.astro";
import "@styles/dashboard.css";
---

<PageLayout>
  <section class="bg-neutral-50">
    <div
      class="mx-auto flex min-h-[70vh] max-w-6xl flex-col items-center justify-center gap-16 px-4 py-20 text-center sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:text-left lg:px-8"
    >
      <div class="max-w-2xl space-y-6">
        <h1
          class="text-3xl font-semibold text-neutral-900 sm:text-4xl lg:text-5xl"
        >
          Accedi e registrati per partecipare alla sfida
        </h1>
        <p class="text-base leading-relaxed text-neutral-700">
          Almeno un membro del team deve registrarsi utilizzando la propria
          email universitaria.
        </p>
        <p class="text-base leading-relaxed text-neutral-700">
          Dopo l'accesso, potrai creare un nuovo team o unirti a uno esistente.
        </p>
      </div>

      <div
        class="w-full max-w-2xl rounded-3xl bg-white p-10 shadow-xl shadow-neutral-900/5 ring-1 ring-neutral-200"
      >
        <div class="space-y-2 text-left">
          <h2 class="text-2xl font-semibold text-neutral-900">
            Continua con Google
          </h2>
          <p class="text-sm text-neutral-600">
            Accedi con l'account universitario (@campus.unimib.it)
          </p>
        </div>

        <form method="POST" action="/api/auth/signin" class="mt-10 space-y-4">
          <input type="hidden" name="provider" value="google" />
          <button type="submit" class="register-oauth-button">
            <span class="register-oauth-icon" aria-hidden="true">
              <svg
                viewBox="-3 0 262 262"
                class="h-5 w-5"
                role="img"
                aria-hidden="true"
              >
                <path
                  d="M255.878 133.451c0-10.734-.871-18.567-2.756-26.69H130.55v48.448h71.947c-1.45 12.04-9.283 30.172-26.69 42.356l-.244 1.622 38.755 30.023 2.685.268c24.659-22.774 38.875-56.282 38.875-96.027"
                  fill="#4285F4"
                  stroke="none"></path>
                <path
                  d="M130.55 261.1c35.248 0 64.839-11.605 86.453-31.622l-41.196-31.913c-11.024 7.688-25.82 13.055-45.257 13.055-34.523 0-63.824-22.773-74.269-54.25l-1.531.13-40.298 31.187-.527 1.465C35.393 231.798 79.49 261.1 130.55 261.1"
                  fill="#34A853"
                  stroke="none"></path>
                <path
                  d="M56.281 156.37c-2.756-8.123-4.351-16.827-4.351-25.82 0-8.994 1.595-17.697 4.206-25.82l-.073-1.73L15.26 71.312l-1.335.635C5.077 89.644 0 109.517 0 130.55s5.077 40.905 13.925 58.602l42.356-32.782"
                  fill="#FBBC05"
                  stroke="none"></path>
                <path
                  d="M130.55 50.479c24.514 0 41.05 10.589 50.479 19.438l36.844-35.974C195.245 12.91 165.798 0 130.55 0 79.49 0 35.393 29.301 13.925 71.947l42.211 32.783c10.59-31.477 39.891-54.251 74.414-54.251"
                  fill="#EB4335"
                  stroke="none"></path>
              </svg>
            </span>
            <span>Continua con Google</span>
          </button>
        </form>
      </div>
    </div>
  </section>
</PageLayout>
