---
import "@styles/globals.css";

import { Footer, Navigation } from "@components/layout";
import {
	ChallengeSection,
	FaqSection,
	HeroSection,
	InstructionsSection,
	LeaderboardSection,
	LogosSection,
	ParticipationSection,
	PlaygroundSection,
	TeamSection,
	TimelineSection,
} from "@components/sections";
import { content } from "@content/website-content";
import WebsiteAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

const pageTitle = "The Safety Game";
const { home, leaderboard, team, participation, dates, instructions, playground, faqs, challenge } = content;
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="The Safety Game - Hackathon organized by MIND, University of Milan Bicocca"
    />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-white">
    <Navigation />
    <WebsiteAnalytics />
    <SpeedInsights />
    <main id="main-content">
      <HeroSection home={home} />
      <ChallengeSection challenge={challenge} />
      <ParticipationSection participation={participation} />
      <TimelineSection dates={dates} />
      <InstructionsSection instructions={instructions} />
      <LeaderboardSection leaderboard={leaderboard} />
      <PlaygroundSection playground={playground} />
      <TeamSection team={team} />
      <FaqSection faqs={faqs} />
    </main>
    <LogosSection />
    <Footer />
  </body>
</html>
