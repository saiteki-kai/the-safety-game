---
export const prerender = false;

import Footer from "@components/common/Footer.astro";
import LandingNavigation from "@components/common/LandingNavigation";
import {
  ChallengeSection,
  FaqSection,
  HeroSection,
  InstructionsSection,
  LeaderboardSection,
  LogosSection,
  ParticipationSection,
  TeamSection,
  TimelineSection,
} from "@components/sections";
import { content } from "@content/website-content";
import PageLayout from "@layouts/PageLayout.astro";

const profile = Astro.locals.user;
---

<PageLayout title="The Safety Game">
  <LandingNavigation slot="navigation" client:load profile={profile} />
  <HeroSection home={content.home} />
  <ChallengeSection challenge={content.challenge} />
  <InstructionsSection instructions={content.instructions} />
  <ParticipationSection participation={content.participation} />
  <TimelineSection dates={content.dates} />
  <LeaderboardSection leaderboard={content.leaderboard} />
  <!-- <PlaygroundSection playground={content.playground} /> -->
  <TeamSection team={content.team} />
  <FaqSection faqs={content.faqs} />
  <LogosSection slot="prefooter" />
  <Footer slot="footer" />
</PageLayout>
