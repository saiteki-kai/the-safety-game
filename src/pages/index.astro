---
import { Footer, Navigation } from "@components/layout";
import {
  ChallengeSection,
  FaqSection,
  HeroSection,
  InstructionsSection,
  LeaderboardSection,
  LogosSection,
  ParticipationSection,
  PlaygroundSection,
  TeamSection,
  TimelineSection,
} from "@components/sections";
import { content } from "@content/website-content";
import PageLayout from "@layouts/PageLayout.astro";

const { home, leaderboard, team, participation, dates, instructions, playground, faqs, challenge } = content;
---

<PageLayout>
  <Navigation slot="navigation" />
  <HeroSection home={home} />
  <ChallengeSection challenge={challenge} />
  <ParticipationSection participation={participation} />
  <TimelineSection dates={dates} />
  <InstructionsSection instructions={instructions} />
  <LeaderboardSection leaderboard={leaderboard} />
  <PlaygroundSection playground={playground} />
  <TeamSection team={team} />
  <FaqSection faqs={faqs} />
  <LogosSection slot="prefooter" />
  <Footer slot="footer" />
</PageLayout>
