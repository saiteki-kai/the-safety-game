---
export const prerender = false;

import Footer from "@components/common/Footer.astro";
import { footer as t } from "@i18n/locales/it";
import { footerQuickLinks } from "@/content/site-config";
import LandingNavigation from "@components/common/LandingNavigation";
import {
  ChallengeSection,
  FaqSection,
  HeroSection,
  InstructionsSection,
  LeaderboardSection,
  LogosSection,
  ParticipationSection,
  TeamSection,
  TimelineSection,
} from "@components/sections";
import { home, challenge, instructions, participation, dates, leaderboard, team, faq } from "@i18n/locales/it";
import PageLayout from "@layouts/PageLayout.astro";

const profile = Astro.locals.user;
---

<PageLayout title="The Safety Game">
  <LandingNavigation slot="navigation" client:load profile={profile} />
  <HeroSection home={home} />
  <ChallengeSection challenge={challenge} />
  <InstructionsSection instructions={instructions} />
  <ParticipationSection participation={participation} />
  <TimelineSection dates={dates} />
  <LeaderboardSection leaderboard={leaderboard} />
  <!-- <PlaygroundSection playground={content.playground} /> -->
  <TeamSection team={team} />
  <FaqSection faqs={faq} />
  <LogosSection slot="prefooter" />
  <Footer slot="footer" t={t} quickLinks={footerQuickLinks} />
</PageLayout>
