---
export const prerender = false;

import "@styles/globals.css";

import RegisterForm from "@components/RegisterForm";
---

<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registrazione | The Safety Game</title>
  </head>
  <body class="register-page">
    <main id="main-content" class="register-wrapper">
      <section class="register-container" aria-labelledby="register-title">
        <header class="register-header">
          <h1 id="register-title">Registrati</h1>
          <p>
            Partecipa come individuo oppure forma un team: compila il modulo per confermare la tua
            iscrizione.
          </p>
        </header>

        <RegisterForm client:load />
      </section>
    </main>
  </body>
</html>
