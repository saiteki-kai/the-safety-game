---
interface SectionLayoutProps {
  id: string;
  title: string;
  description?: string;
  sectionClass?: string;
}

const { id, title, description, sectionClass = "" } = Astro.props as SectionLayoutProps;
---

<section id={id} class:list={[sectionClass, "section-layout"]}>
  <div class="section-container">
    <header class="section-header text-center">
      <h2 class="section-title">{title}</h2>
      {description && <p class={"section-description"} set:html={description} />}
      <slot name="header" />
    </header>
    <slot />
  </div>
</section>
