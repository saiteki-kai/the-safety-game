---
import "@styles/globals.css";

import { ClientRouter } from "astro:transitions";
import { ScrollToTopButton } from "@components/common/ScrollToTopButton";
import { ScrollArea } from "@components/ui/scroll-area";
import { Toaster } from "@components/ui/sonner";
import WebsiteAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import i18n from "i18next";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "The Safety Game - Hackathon organized by MIND, University of Milan Bicocca" } =
  Astro.props as Props;
---

<html lang={i18n.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="h-screen overflow-hidden bg-white">
    <slot name="navigation" />
    <Toaster client:load />
    <WebsiteAnalytics />
    <SpeedInsights />
    <ScrollArea className="h-screen" client:load>
      <main id="main-content" class="flex min-h-0 flex-col">
        <slot />
      </main>
      <ScrollToTopButton client:load />
      <slot name="prefooter" />
      <slot name="footer" />
    </ScrollArea>
  </body>
</html>
