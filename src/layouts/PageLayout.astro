---
import "@styles/globals.css";

import { ClientRouter } from "astro:transitions";
import { ScrollToTopButton } from "@components/common/ScrollToTopButton";
import { ScrollArea } from "@components/ui/scroll-area";
import { Toaster } from "@components/ui/sonner";
import WebsiteAnalytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";

import { type Locale, DEFAULT_LOCALE } from "@/lib/translations";

interface Props {
  title: string;
  description?: string;
  lang?: Locale;
}

const { title, description = "The Safety Game - Hackathon organized by MIND, University of Milan Bicocca", lang } =
  Astro.props as Props;

const locale = lang ?? DEFAULT_LOCALE;
---

<html lang={locale || "it"}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="h-dvh overflow-hidden bg-white">
    <slot name="navigation" />
    <Toaster client:load />
    <WebsiteAnalytics />
    <SpeedInsights />
      <ScrollArea className="h-dvh w-screen" client:load>
        <main id="main-content" class="flex min-h-0 w-screen flex-col">
        <slot />
      </main>
      <ScrollToTopButton client:idle />
      <slot name="prefooter" />
      <slot name="footer" />
    </ScrollArea>
  </body>
</html>
